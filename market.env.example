# Copy to .env.local locally, or set these server-only variables in Vercel.
# Leave MARKET_ADDRESS empty to keep all new trading inactive.
MARKET_ADDRESS=
MARKET_CHAIN_ID=1
MARKET_RPC_URL=https://ethereum-rpc.publicnode.com
MARKET_INDEXER_URL=https://api.ethscriptions.com/v2

# Dedicated verifier signing key; its public address MUST match the contract's
# immutable ownershipVerifier. Never use the treasury/main wallet key here.
# Never prefix this variable with NEXT_PUBLIC_, paste it in chat, or commit it.
MARKET_VERIFIER_PRIVATE_KEY=
