# For local operator setup; keep real keys in the ignored .env.local only.
MAINNET_VERIFIER_PRIVATE_KEY=
MAINNET_MARKET_ADDRESS=
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
MAINNET_INDEXER_URL=https://api.ethscriptions.com/v2

# For the public site's Vercel server environment, after mainnet deployment:
MARKET_CHAIN_ID=1
MARKET_ADDRESS=
MARKET_RPC_URL=https://ethereum-rpc.publicnode.com
MARKET_INDEXER_URL=https://api.ethscriptions.com/v2
# Set this to the mainnet verifier key using Vercel's secret environment input.
MARKET_VERIFIER_PRIVATE_KEY=
